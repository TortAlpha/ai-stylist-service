# AI / Stylist service env vars.
# Full reference: server/ai-service/DESIGN.md → Конфигурация

# --- Service ---
SERVICE_PORT=8084
LOG_LEVEL=info

# --- OpenAI (chat only) ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_REQUEST_TIMEOUT_SECONDS=30

# --- Multimodal embedding (Cohere, dim 1024) ---
# Must match product-service. Changing provider/dim requires full reindex.
MULTIMODAL_EMBED_PROVIDER=cohere
MULTIMODAL_EMBED_MODEL=embed-multilingual-v3.0
MULTIMODAL_EMBED_DIM=1024
MULTIMODAL_EMBED_API_KEY=
MULTIMODAL_EMBED_BASE_URL=
MULTIMODAL_EMBED_TIMEOUT_SECONDS=15

# --- Product service ---
PRODUCT_SERVICE_URL=http://sc-product-service:8081
PRODUCT_SERVICE_TIMEOUT_SECONDS=5
INTERNAL_API_TOKEN=

# --- Conversation / context budget ---
MAX_HISTORY_MESSAGES=30
HISTORY_TOKEN_BUDGET=6000
MAX_TOOL_ITERATIONS=4
MAX_TOKENS_PER_REPLY=800
CONVERSATION_TTL_MINUTES=30

# --- Rate limits ---
RATE_LIMIT_MESSAGES_PER_MIN=12
RATE_LIMIT_TOKENS_PER_DAY=50000
QUERY_EMBED_DAILY_CAP=10000

# --- Auth (optional, defence-in-depth; JWT primarily verified on nginx) ---
JWT_SECRET=
