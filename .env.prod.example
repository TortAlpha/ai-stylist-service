# Copy to .env on the deployment host and fill in real values.
# Never commit the filled .env — it contains secrets.

# Version of the release to run (matches a git tag, e.g. v0.1.0).
SC_VERSION=v0.1.0

# GHCR owner (org or user that published the images).
GHCR_OWNER=tortalpha

# ---- Postgres credentials (one per service) ----
PRODUCT_DB_USER=postgres
PRODUCT_DB_PASSWORD=change-me
PRODUCT_DB_NAME=product_db

USER_DB_USER=postgres
USER_DB_PASSWORD=change-me
USER_DB_NAME=user_db

AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=change-me
AUTH_DB_NAME=auth_db

# ---- MinIO / object storage ----
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-long-random
S3_IMAGES_BUCKET=ava-product-images
S3_PREVIEW_BUCKET=ava-product-previews
AWS_ENDPOINT_URL=http://minio:9000
# Public URL where uploaded images are reachable from browsers.
# For Cloudflare Tunnel setup this is usually https://<your-domain>/minio.
S3_PUBLIC_URL=http://localhost:9000
AWS_REGION=us-east-1

# ---- Auth ----
# Generate with: openssl rand -hex 48
JWT_SECRET=change-me-long-random

# ---- Optional log level overrides ----
# PRODUCT_RUST_LOG=info,actix_web=info,product_service=debug,sqlx=warn
# AUTH_RUST_LOG=info
# USER_RUST_LOG=info
