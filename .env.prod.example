# Copy to .env on the deployment host and fill in real values.
# Never commit the filled .env — it contains secrets.

# Version of the release to run (matches a git tag, e.g. v0.1.0).
SC_VERSION=v0.1.0

# GHCR owner (org or user that published the images).
GHCR_OWNER=tortalpha

# ---- Postgres credentials (one per service) ----
PRODUCT_DB_USER=postgres
PRODUCT_DB_PASSWORD=change-me
PRODUCT_DB_NAME=product_db

USER_DB_USER=postgres
USER_DB_PASSWORD=change-me
USER_DB_NAME=user_db

AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=change-me
AUTH_DB_NAME=auth_db

# ---- MinIO / object storage ----
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me-long-random
S3_IMAGES_BUCKET=ava-product-images
S3_PREVIEW_BUCKET=ava-product-previews
AWS_ENDPOINT_URL=http://minio:9000
# Public URL where uploaded images are reachable from browsers.
# For Cloudflare Tunnel setup this is usually https://<your-domain>/minio.
S3_PUBLIC_URL=http://localhost:9000
AWS_REGION=us-east-1

# ---- Auth ----
# Generate with: openssl rand -hex 48
JWT_SECRET=change-me-long-random

# ---- AI / Stylist service ----
# OpenAI chat key (must be set in prod, otherwise /api/stylist/chat returns upstream_unavailable).
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# Cohere multimodal embeddings (used by ai-service and product-service).
# Provider and dim are fixed (see server/ai-service/DESIGN.md). Changing requires full reindex.
MULTIMODAL_EMBED_PROVIDER=cohere
MULTIMODAL_EMBED_MODEL=embed-multilingual-v3.0
MULTIMODAL_EMBED_DIM=1024
MULTIMODAL_EMBED_API_KEY=

# Shared secret for product-service internal endpoints (e.g. /internal/products/semantic-search).
INTERNAL_API_TOKEN=change-me-long-random

# LangSmith (LLM observability for the stylist tool-use loop).
# Set LANGSMITH_TRACING=false to disable without removing the SDK.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sc-ai-service
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---- Optional log level overrides ----
# PRODUCT_RUST_LOG=info,actix_web=info,product_service=debug,sqlx=warn
# AUTH_RUST_LOG=info
# USER_RUST_LOG=info
# AI_LOG_LEVEL=info
